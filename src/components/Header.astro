---
import { site, href, BASE } from "../lib/data";
const path = "/" + Astro.url.pathname.slice(BASE.length);
const items = [
  { href: "/tonight/", label: "Tonight" },
  { href: "/sort-me/", label: "Sort me" },
  { href: "/world/", label: "World Cinema" },
  { href: "/2026/", label: "Sorted 2026" },
  { href: "/lists/", label: "Lists" },
  { href: "/watch/", label: "Where to Watch" },
  { href: "/passport/", label: "Passport" },
  { href: "/search/", label: "Search" },
];
const current = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={href("/")} aria-label={`${site.name} home`}>
      <span class="word">Sorted <em>Cinema</em></span>
      <span class="presents">presents</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav" data-nav-toggle>Menu</button>
    <nav class="nav" id="nav" aria-label="Primary">
      {items.map((i) => <a href={href(i.href)} aria-current={current(i.href) ? "page" : undefined}>{i.label}</a>)}
      <a class="cta" href={site.merch} rel="noopener" target="_blank">{site.merchLabel}</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const nav = document.getElementById("nav");
  const set = (open: boolean) => {
    if (!btn || !nav) return;
    nav.classList.toggle("open", open);
    btn.setAttribute("aria-expanded", String(open));
    btn.textContent = open ? "Close" : "Menu";
    document.body.classList.toggle("nav-open", open);
  };
  btn?.addEventListener("click", () => set(!nav?.classList.contains("open")));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") set(false); });
  document.addEventListener("click", (e) => {
    const t = e.target as Node;
    if (nav?.classList.contains("open") && !nav.contains(t) && !btn?.contains(t)) set(false);
  });
  nav?.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) set(false); });
  matchMedia("(min-width: 821px)").addEventListener("change", (e) => { if (e.matches) set(false); });
</script>
