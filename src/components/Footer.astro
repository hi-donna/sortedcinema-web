---
import { site, data, href } from "../lib/data";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <h4>Sorted Cinema</h4>
        <p style="max-width:44ch">{site.tagline} Made by the people behind <a href={site.instagram} rel="noopener" target="_blank">{site.handle}</a>. Every list here started as a carousel, or is about to become one.</p>
      </div>
      <div>
        <h4>Browse</h4>
        <ul>
          <li><a href={href("/lists/")}>All lists</a></li>
          <li><a href={href("/world/")}>World cinema</a></li>
          <li><a href={href("/2026/")}>Sorted 2026</a></li>
          <li><a href={href("/watch/")}>Where to watch in India</a></li>
          <li><a href={href("/mood/tense/")}>By mood</a></li>
        </ul>
      </div>
      <div>
        <h4>Elsewhere</h4>
        <ul>
          <li><a href={site.instagram} rel="noopener" target="_blank">Instagram</a></li>
          <li><a href={site.merch} rel="noopener" target="_blank">{site.merchLabel}</a></li>
          <li><a href={href("/about/")}>About & guest lists</a></li>
        </ul>
      </div>
    </div>
    <div class="attr">
      <span>© {year} Sorted Cinema.</span>
      <span>Film data and images from <a href="https://www.themoviedb.org" rel="noopener" target="_blank">TMDB</a>. This product uses the TMDB API but is not endorsed or certified by TMDB.</span>
      <span>Streaming availability by <a href="https://www.justwatch.com" rel="noopener" target="_blank">JustWatch</a>, for India{data.stats?.today ? `, refreshed ${data.stats.today}` : ""}.</span>
    </div>
  </div>
</footer>
