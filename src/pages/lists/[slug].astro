---
import Base from "../../layouts/Base.astro";
import FilmRow from "../../components/FilmRow.astro";
import ListCard from "../../components/ListCard.astro";
import { data, site, film, coverOf, dateLabel, href } from "../../lib/data";

export function getStaticPaths() {
  return data.collections.filter((c) => c.kind !== "year").map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const art = coverOf(c, "original");
const curator = data.curators[c.curator];
const description = c.intro || `${c.count} ${c.media === "tv" ? "shows" : "films"}: ${c.films.slice(0, 4).map((e) => film(e.key).title).join(", ")}…`;
const related = data.collections.filter((x) => x.slug !== c.slug && x.kind !== "year" && (x.category === c.category || x.kind === c.kind)).slice(0, 4);
const pub = dateLabel(c.published);
const tiers = c.layout === "tiers" ? [...new Set(c.films.map((e) => e.tier || "Unranked"))] : [];
const jsonld = {
  "@context": "https://schema.org", "@type": "ItemList", name: c.title, description,
  itemListElement: c.films.map((e) => ({ "@type": "ListItem", position: e.position, name: film(e.key).title, url: `${site.url}/film/${e.key}/` })),
};
---
<Base title={c.title} description={description} image={art} type="article" jsonld={jsonld}>
  <section class="page-hero">
    {art && <div class="bg" style={`background-image:url('${art}')`}></div>}
    <div class="grade"></div>
    <div class="wrap inner">
      <div class="eyebrow">{c.kicker || (c.kind === "archive" ? `From the grid · ${c.category}` : "Sorted Cinema")}</div>
      <h1 style="margin-top:12px">{c.title}</h1>
      {c.intro && <p class="lede">{c.intro}</p>}
      <div class="meta">
        <span>{c.count} {c.media === "tv" ? "shows" : "films"}</span>
        {curator && <span>Curated by <a href={curator.url} rel="noopener" target="_blank" class="accent">{curator.handle}</a></span>}
        {pub && <span>{pub.month} {pub.year}</span>}
        {c.source?.permalink && <span><a class="accent" href={c.source.permalink} rel="noopener" target="_blank">See the post ↗</a></span>}
      </div>
      <div class="list-progress" data-progress={JSON.stringify(c.films.map((e) => e.key))} style="margin-top:18px;max-width:420px" hidden>
        <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--text-2);margin-bottom:6px"><span data-progress-label></span><a class="accent" href={href("/passport/")}>Your passport →</a></div>
        <div class="progress"><i data-progress-bar></i></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {c.layout === "tiers" ? (
        tiers.map((t) => (
          <div class="tier">
            <h3>{t}</h3>
            {c.films.filter((e) => (e.tier || "Unranked") === t).map((e) => <FilmRow e={e} total={c.count} showIndex={false} />)}
          </div>
        ))
      ) : (
        c.films.map((e) => <FilmRow e={e} total={c.count} />)
      )}
    </div>
  </section>

  {related.length ? (
    <section class="section">
      <div class="wrap">
        <div class="section-head"><div><div class="eyebrow">Keep going</div><h2>More like this</h2></div></div>
        <div class="grid">{related.map((r) => <ListCard c={r} />)}</div>
      </div>
    </section>
  ) : null}
<script>
  import { load, progress } from "../../lib/client";
  const box = document.querySelector<HTMLElement>("[data-progress]");
  if (box) {
    const keys = JSON.parse(box.dataset.progress!);
    const paint = (p: any) => { const r = progress(keys, p); box.hidden = false; box.querySelector("[data-progress-label]")!.textContent = r.n ? `You've seen ${r.n} of ${r.total} · ${r.pct}% stamped` : `Mark what you've seen — ${r.total} to go`; (box.querySelector("[data-progress-bar]") as HTMLElement).style.width = r.pct + "%"; };
    paint(load()); document.addEventListener("sc:passport", (e: any) => paint(e.detail));
  }
</script>
</Base>
